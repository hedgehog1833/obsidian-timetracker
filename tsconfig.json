{
	"compilerOptions": {
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"importHelpers": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["DOM", "ES5", "ES6", "ES7", "ESNext"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"noImplicitAny": true,
		"rootDir": ".",
		"strictNullChecks": true,
		"target": "ES6",
		"types": ["node", "jest"]
	},
	"include": ["**/*.ts", "**/*.tsx"]
}
